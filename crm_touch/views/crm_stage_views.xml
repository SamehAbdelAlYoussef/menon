<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- CRM Stage Form: add is_design_stage (Admin only) -->
    <record id="crm_stage_form_view_inherit_design_stage" model="ir.ui.view">
        <field name="name">crm.stage.form.inherit.design_stage</field>
        <field name="model">crm.stage</field>
        <field name="inherit_id" ref="crm.crm_stage_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_won']" position="after">
                <field name="is_design_stage"
                       groups="base.group_system"
                       widget="boolean_toggle"/>
                <field name="is_inspection_stage"
                       groups="base.group_system"
                       widget="boolean_toggle"/>
                <field name="is_operations_stage"
                       groups="base.group_system"
                       widget="boolean_toggle"/>
                <field name="is_request_inspection"
                       groups="base.group_system"
                       string="Request for Inspection"
                     />
                <field name="is_sales_person_stage"
                       groups="base.group_system"
                       widget="boolean_toggle"/>
                <field name="is_sales_stage"
                       groups="base.group_system"
                       widget="boolean_toggle"/>
                <field name="is_work_order_stage"
                       groups="base.group_system"
                       widget="boolean_toggle"/>
                <field name="design_phase_user_id"
                       groups="base.group_system"
                       string="Design Phase Salesperson"
                       invisible="not is_design_phase"/>
                <field name="is_work_order_trigger"
                       groups="base.group_system"
                       string="Technical Office"
                     />
            </xpath>
        </field>
    </record>

</odoo>
