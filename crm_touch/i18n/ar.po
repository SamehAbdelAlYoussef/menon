#. module: crm_touch
#: model:mail.template,body_html:crm_touch.mail_template_crm_lead_assigned
msgid ""
"<div style=\"background-color: #f8fafc; padding: 40px 10px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; direction: ltr;\">\n"
"                <table align=\"center\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width: 600px; margin: 0 auto; background-color: #ffffff; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03); overflow: hidden;\">\n"
"                    <tr>\n"
"                        <td style=\"background-color: #6366f1; padding: 32px 30px; text-align: left;\">\n"
"                            <h2 style=\"color: #ffffff; margin: 0; font-size: 22px; font-weight: 700; letter-spacing: -0.5px;\">\n"
"                                New Lead Assigned\n"
"                            </h2>\n"
"                            <p style=\"color: #e0e7ff; margin: 6px 0 0; font-size: 14px;\">\n"
"                                Odoo CRM Notification\n"
"                            </p>\n"
"                        </td>\n"
"                    </tr>\n"
"\n"
"                    <tr>\n"
"                        <td style=\"padding: 35px 30px;\">\n"
"                            <p style=\"margin: 0 0 24px; font-size: 15px; color: #1e293b; line-height: 1.5;\">\n"
"                                Dear <strong><t t-out=\"object.user_id.name or 'User'\"/></strong>,\n"
"                            </p>\n"
"                            <p style=\"margin: 0 0 20px; font-size: 14px; color: #64748b; line-height: 1.5;\">\n"
"                                You have been assigned as the salesperson for the following lead:\n"
"                            </p>\n"
"\n"
"                            <div style=\"border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden; margin-bottom: 28px;\">\n"
"                                <table width=\"100%\" cellpadding=\"14\" cellspacing=\"0\" style=\"border-collapse: collapse;\">\n"
"                                    <tr style=\"border-bottom: 1px solid #e2e8f0;\">\n"
"                                        <td style=\"background-color: #f8fafc; font-weight: 600; color: #475569; width: 35%; font-size: 13px; text-transform: uppercase;\">Lead Name</td>\n"
"                                        <td style=\"color: #0f172a; font-weight: 500; font-size: 14px;\"><t t-out=\"object.name or 'n/a'\"/></td>\n"
"                                    </tr>\n"
"                                    <tr style=\"border-bottom: 1px solid #e2e8f0;\">\n"
"                                        <td style=\"background-color: #f8fafc; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase;\">Stage</td>\n"
"                                        <td style=\"color: #0f172a; font-size: 14px;\">\n"
"                                            <span style=\"background-color: #e0e7ff; color: #4338ca; padding: 2px 8px; border-radius: 4px; font-size: 12px; font-weight: 600;\">\n"
"                                                <t t-out=\"object.stage_id.name or 'New'\"/>\n"
"                                            </span>\n"
"                                        </td>\n"
"                                    </tr>\n"
"                                    <tr style=\"border-bottom: 1px solid #e2e8f0;\">\n"
"                                        <td style=\"background-color: #f8fafc; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase;\">Customer</td>\n"
"                                        <td style=\"color: #0f172a; font-size: 14px;\">\n"
"                                            <t t-if=\"object.partner_id\">\n"
"                                                <t t-out=\"object.partner_id.name\"/>\n"
"                                            </t>\n"
"                                                <t t-else=\"\"><span style=\"color: #94a3b8; font-style: italic;\">Not Specified</span></t>\n"
"                                        </td>\n"
"                                    </tr>\n"
"                                    <t t-if=\"object.expected_revenue\">\n"
"                                        <tr style=\"border-bottom: 1px solid #e2e8f0;\">\n"
"                                            <td style=\"background-color: #f8fafc; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase;\">Expected Revenue</td>\n"
"                                            <td style=\"color: #16a34a; font-weight: 600; font-size: 14px;\">\n"
"                                                <t t-out=\"object.expected_revenue\" t-options=\"{'widget': 'monetary', 'display_currency': object.company_id.currency_id}\"/>\n"
"                                            </td>\n"
"                                        </tr>\n"
"                                    </t>\n"
"                                    <t t-if=\"object.contact_name\">\n"
"                                        <tr>\n"
"                                            <td style=\"background-color: #f8fafc; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase;\">Contact</td>\n"
"                                            <td style=\"color: #0f172a; font-size: 14px;\">\n"
"                                                <t t-out=\"object.contact_name\"/>\n"
"                                            </td>\n"
"                                        </tr>\n"
"                                    </t>\n"
"                                </table>\n"
"                            </div>\n"
"\n"
"                            <div style=\"text-align: center; margin: 32px 0 24px;\">\n"
"                                <a t-att-href=\"'/web#id=%s&amp;model=crm.lead&amp;view_type=form' % object.id\" style=\"display: inline-block; padding: 14px 32px; background-color: #6366f1; color: #ffffff; text-decoration: none; border-radius: 6px; font-size: 14px; font-weight: 600; box-shadow: 0 4px 6px -1px rgba(99, 102, 241, 0.2);\">\n"
"                                    View Lead Details\n"
"                                </a>\n"
"                            </div>\n"
"\n"
"                            <hr style=\"border: 0; border-top: 1px solid #f1f5f9; margin: 30px 0 20px;\"/>\n"
"                            <p style=\"margin: 0; font-size: 13px; color: #64748b; line-height: 1.5;\">\n"
"                                Best regards,<br/>\n"
"                                <strong style=\"color: #475569;\"><t t-out=\"object.company_id.name or user.company_id.name or 'CRM Team'\"/></strong>\n"
"                            </p>\n"
"                        </td>\n"
"                    </tr>\n"
"\n"
"                    <tr>\n"
"                        <td style=\"background-color: #f8fafc; padding: 20px 30px; text-align: center; font-size: 12px; color: #94a3b8; border-top: 1px solid #f1f5f9;\">\n"
"                            This is an automated operational email sent from <strong><t t-out=\"object.company_id.name or 'Odoo CRM'\"/></strong>.\n"
"                        </td>\n"
"                    </tr>\n"
"                </table>\n"
"            </div>\n"
"             "
msgstr ""

#. module: crm_touch
#: model_terms:ir.ui.view,arch_db:crm_touch.crm_meeting_action_wizard_form_view
msgid ""
"<i class=\"fa fa-exclamation-triangle me-1\" title=\"Warning\"/>\n"
"                    <strong>Not Available: </strong>\n"
"                    Meeting actions are only available when the lead is in the\n"
"                    <strong>\"Meeting with Client\"</strong> stage."
msgstr ""
"<i class=\"fa fa-exclamation-triangle me-1\" title=\"تحذير\"/>\n"
"                    <strong>غير متاح: </strong>\n"
"                    إجراءات الاجتماع متاحة فقط عندما يكون العميل المحتمل في\n"
"                    مرحلة <strong>\"اجتماع مع العميل\"</strong>."

#. module: crm_touch
#: model_terms:ir.ui.view,arch_db:crm_touch.crm_meeting_action_wizard_form_view
msgid ""
"<i class=\"fa fa-info-circle me-1\" title=\"Info\"/>\n"
"                        A <strong>draft Sales Order</strong> will be created and linked\n"
"                        to this opportunity automatically upon confirmation."
msgstr ""
"<i class=\"fa fa-info-circle me-1\" title=\"معلومة\"/>\n"
"                        سيتم إنشاء <strong>أمر بيع مسودة</strong> وربطه\n"
"                        بهذه الفرصة تلقائياً عند التأكيد."

