<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Queue list view -->
    <record id="view_remote_sync_queue_list" model="ir.ui.view">
        <field name="name">remote.sync.queue.list</field>
        <field name="model">remote.sync.queue</field>
        <field name="arch" type="xml">
            <list string="Sync Queue" decoration-danger="state=='failed'" decoration-muted="state=='done'">
                <field name="model"/>
                <field name="local_id"/>
                <field name="operation"/>
                <field name="state"/>
                <field name="retry_count"/>
                <field name="create_date"/>
                <field name="process_date"/>
                <field name="error_message" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Queue form view -->
    <record id="view_remote_sync_queue_form" model="ir.ui.view">
        <field name="name">remote.sync.queue.form</field>
        <field name="model">remote.sync.queue</field>
        <field name="arch" type="xml">
            <form string="Sync Queue Item">
                <sheet>
                    <group>
                        <field name="model"/>
                        <field name="local_id"/>
                        <field name="operation"/>
                        <field name="state"/>
                        <field name="retry_count"/>
                        <field name="max_retries"/>
                    </group>
                    <group string="Dates">
                        <field name="create_date"/>
                        <field name="process_date"/>
                    </group>
                    <group string="Error">
                        <field name="error_message"/>
                    </group>
                    <group string="Values">
                        <field name="values"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action window for queue -->
    <record id="action_remote_sync_queue" model="ir.actions.act_window">
        <field name="name">Sync Queue</field>
        <field name="res_model">remote.sync.queue</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
