<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit sale.view_order_product_pivot — add stock measures -->
    <record id="view_order_product_pivot_add_stock" model="ir.ui.view">
        <field name="name">sale.report.pivot.add.stock</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.view_order_product_pivot"/>
        <field name="arch" type="xml">
            <field name="product_uom_qty" position="after">
                <field name="stock_on_hand" type="measure"/>
                <field name="stock_available" type="measure"/>
                <field name="stock_reserved" type="measure"/>
            </field>
        </field>
    </record>

</odoo>
