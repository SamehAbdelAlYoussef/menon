<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_form_scale" model="ir.ui.view">
        <field name="name">purchase.order.form.scale</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- زرار أوامر البيع المرتبطة في الهيدر -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_related_sale_orders"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        invisible="related_sale_order_count == 0">
                    <field name="related_sale_order_count" widget="statinfo" string="أوامر البيع"/>
                </button>
            </xpath>
            <!-- Order lines list view -->
            <xpath expr="//field[@name='order_line']/list//field[@name='price_unit']" position="before">
                <field name="scale_id" optional="show"/>
                <field name="scale_discount" optional="show"/>
                <field name="qty_after_scale_discount" optional="show"/>
                <field name="customer_id" optional="show" options="{'no_create': True}"/>
                <field name="generated_sale_line_id" column_invisible="1"/>
            </xpath>
            <!-- Order line form (dialog) view -->
            <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']" position="before">
                <field name="scale_id"/>
                <label for="scale_discount" string="خصم الميزان"/>
                <div name="scale_discount_div">
                    <field name="scale_discount" class="oe_inline"/> %
                </div>
                <field name="qty_after_scale_discount"/>
                <field name="customer_id" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <!-- Scale menu under Purchase -->
    <menuitem id="menu_scale_scale_purchase"
              name="الميزان"
              parent="purchase.menu_purchase_root"
              action="action_scale_scale"
              sequence="25"/>

</odoo>
