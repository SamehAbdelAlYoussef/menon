<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_taqseet_companies_document">
        <t t-call="web.external_layout">
            <!-- Detect Arabic user -->
            <t t-set="is_ar" t-value="(env.user.lang or '').startswith('ar')"/>

            <div class="page" t-att-dir="'rtl' if is_ar else 'ltr'">
                <style>
                    .report-table { width: 100%; border-collapse: collapse; margin-top: 16px; }
                    .report-table th, .report-table td { border: 1px solid #ccc; padding: 6px 10px; font-size: 11px; }
                    .report-table thead th { background-color: #2c3e50; color: white; font-weight: bold; }
                    .report-table tfoot td { background-color: #ecf0f1; font-weight: bold; }
                    .num-col { text-align: right; }
                    .h2-title { text-align: center; margin-bottom: 16px; font-size: 16px; font-weight: bold; }
                </style>

                <h2 class="h2-title">
                    <t t-if="is_ar">تقرير حسابات شركات التقسيط</t>
                    <t t-else="">Installment Companies Report</t>
                </h2>

                <table class="report-table">
                    <thead>
                        <tr>
                            <th style="width:40px; text-align:center;">#</th>
                            <th>
                                <t t-if="is_ar">الشركة</t>
                                <t t-else="">Company</t>
                            </th>
                            <th class="num-col">
                                <t t-if="is_ar">الرصيد</t>
                                <t t-else="">Balance</t>
                            </th>
                            <th class="num-col">
                                <t t-if="is_ar">مصروفات إدارية</t>
                                <t t-else="">Administrative Expenses</t>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="accounts" t-as="acc">
                            <tr>
                                <td style="text-align:center;"><t t-esc="acc_index + 1"/></td>
                                <td><t t-esc="acc.name"/></td>
                                <td class="num-col"><t t-esc="'{:,.2f}'.format(acc.current_balance)"/></td>
                                <td class="num-col"><t t-esc="'{:,.2f}'.format(acc.taqseet_account_balance)"/></td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="2" class="num-col">
                                <t t-if="is_ar">الإجمالي</t>
                                <t t-else="">Total</t>
                            </td>
                            <td class="num-col">
                                <t t-esc="'{:,.2f}'.format(sum(accounts.mapped('current_balance')))"/>
                            </td>
                            <td class="num-col">
                                <t t-esc="'{:,.2f}'.format(sum(accounts.mapped('taqseet_account_balance')))"/>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </t>
    </template>

    <template id="report_taqseet_companies">
        <t t-call="web.html_container">
            <t t-set="accounts" t-value="env['account.account'].search([('is_taqseet_company', '=', True)])"/>
            <t t-call="custome_accounting_menon.report_taqseet_companies_document"/>
        </t>
    </template>

</odoo>
