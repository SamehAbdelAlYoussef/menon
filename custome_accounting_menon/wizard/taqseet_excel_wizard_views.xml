<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_taqseet_excel_wizard_form" model="ir.ui.view">
        <field name="name">taqseet.excel.wizard.form</field>
        <field name="model">taqseet.excel.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Excel">
                <group invisible="not excel_file">
                    <field name="excel_file" filename="file_name" widget="binary" string="Download Excel"/>
                    <field name="file_name" invisible="1"/>
                </group>
                <footer>
                    <button name="action_export_excel" string="Export Excel" type="object" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_taqseet_excel_wizard" model="ir.actions.act_window">
        <field name="name">Export Excel</field>
        <field name="res_model">taqseet.excel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
