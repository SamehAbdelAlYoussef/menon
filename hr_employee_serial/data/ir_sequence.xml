<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Sequence for auto-generating employee serial numbers -->
        <record id="seq_hr_employee_serial" model="ir.sequence">
            <field name="name">Employee Serial Number</field>
            <field name="code">hr.employee.serial</field>
            <field name="prefix">EMP-</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
