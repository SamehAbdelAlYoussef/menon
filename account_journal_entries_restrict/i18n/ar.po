#. module: account_journal_entries_restrict
#: model:ir.module.module,description:account_journal_entries_restrict.module_meta_information
msgid "Restrict Journal Entries Menu"
msgstr "تقييد قوائم إدخالات اليومية ولوحات المعلومات"

#. module: account_journal_entries_restrict
#: model:ir.module.module,shortdesc:account_journal_entries_restrict.module_meta_information
msgid "Restrict Journal Entries & Dashboard menus to specific groups only"
msgstr "تقييد قوائم إدخالات اليومية ولوحات المعلومات للمستخدمين الحاصلين على صلاحيات محددة فقط"

#. module: account_journal_entries_restrict
#: model:ir.module.module,description:account_journal_entries_restrict.module_meta_information
msgid ""
"\n"
"        This module creates security groups to restrict access to:\n"
"        1. \"Journal Entries\" menu under Accounting → only visible to users with \"Journal Entries views\" group\n"
"        2. \"Dashboards\" application → only visible to users with \"Dashboard Viewer\" group or Dashboard Admin\n"
"\n"
"        Without these groups, the menus are completely hidden from ALL users.\n"
"    "
msgstr ""
"\n"
"        يقوم هذا الموديل بإنشاء مجموعات صلاحيات لتقييد الوصول إلى:\n"
"        1. قائمة \"Journal Entries\" تحت المحاسبة → تظهر فقط للمستخدمين الحاصلين على صلاحية \"Journal Entries views\"\n"
"        2. تطبيق \"Dashboards\" → يظهر فقط للمستخدمين الحاصلين على صلاحية \"Dashboard Viewer\" أو مدير لوحات المعلومات\n"
"\n"
"        بدون هذه الصلاحيات، القوائم تكون مخفية بالكامل عن جميع المستخدمين.\n"
"    "

#. module: account_journal_entries_restrict
#: model:res.groups,name:account_journal_entries_restrict.group_journal_entries_views
msgid "Journal Entries views"
msgstr "مشاهدة إدخالات اليومية"

#. module: account_journal_entries_restrict
#: model:res.groups,name:account_journal_entries_restrict.group_dashboard_viewer
msgid "Dashboard Viewer"
msgstr "مشاهدة لوحات المعلومات"
