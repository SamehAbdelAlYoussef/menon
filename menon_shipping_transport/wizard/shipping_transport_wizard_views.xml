<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="shipping_transport_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.shipping.transport.form</field>
        <field name="model">sale.order.shipping.transport</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="sale_order_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="amount" placeholder="أدخل قيمة المشال والشحن"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button type="object"
                            string="إضافة"
                            name="action_add_shipping_transport"
                            class="btn btn-primary"
                            data-hotkey="q"/>
                    <button special="cancel"
                            string="إلغاء"
                            class="btn btn-secondary"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
