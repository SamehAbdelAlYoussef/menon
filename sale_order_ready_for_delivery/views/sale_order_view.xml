<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================= -->
    <!-- Tree View: delivery status column with badge widget           -->
    <!-- ============================================================= -->
    <record id="sale_order_tree_ready_delivery" model="ir.ui.view">
        <field name="name">sale.order.tree.ready.delivery</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="ready_for_delivery"
                       string="Delivery"
                       widget="badge"
                       decoration-success="ready_for_delivery == 'ready'"
                       decoration-danger="ready_for_delivery == 'not_ready'"
                       invisible="state != 'draft' and state != 'sent'"
                       optional="show"/>
            </field>
        </field>
    </record>

    <!-- ============================================================= -->
    <!-- Form View: show delivery status                               -->
    <!-- ============================================================= -->
    <record id="sale_order_form_ready_delivery" model="ir.ui.view">
        <field name="name">sale.order.form.ready.delivery</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="ready_for_delivery"
                       widget="badge"
                       decoration-success="ready_for_delivery == 'ready'"
                       decoration-danger="ready_for_delivery == 'not_ready'"
                       decoration-muted="ready_for_delivery == False"
                       readonly="1"
                       invisible="state != 'draft' and state != 'sent'"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================= -->
    <!-- Search View: add filters                                      -->
    <!-- ============================================================= -->
    <record id="sale_order_search_ready_delivery" model="ir.ui.view">
        <field name="name">sale.order.search.ready.delivery</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <filter name="my_sale_orders_filter" position="after">
                <separator/>
                <filter name="ready_for_delivery_filter"
                        string="Ready for Delivery"
                        domain="[('ready_for_delivery', '=', 'ready')]"
                        help="Sales orders where all products are available in stock"/>
                <filter name="not_ready_for_delivery_filter"
                        string="Not Ready for Delivery"
                        domain="[('ready_for_delivery', '=', 'not_ready'), ('state', 'in', ('draft','sent'))]"
                        help="Pending sales orders not yet ready for delivery"/>
            </filter>
        </field>
    </record>

</odoo>
