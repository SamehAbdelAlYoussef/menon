<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ============================================================= -->
    <!-- Cron Job: Recalculate Sales Order Readiness every 30 minutes  -->
    <!-- ============================================================= -->
    <record id="cron_recalculate_ready_for_delivery" model="ir.cron">
        <field name="name">Recalculate Sales Order Readiness</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model.cron_recalculate_ready_for_delivery()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
    </record>

</odoo>
